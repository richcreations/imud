# imud.conf — IMU daemon configuration
# Copy to /etc/imud/imud.conf or ~/.config/imud/imud.conf
#
# Keys marked [restart] require a daemon restart to take effect.
# Keys marked [hot]     can be reloaded with SIGHUP at runtime.

[device]
i2c_bus        = "/dev/i2c-1"
gpio_chip      = "gpiochip4"     # Raspberry Pi 5 (RP1) — use "gpiochip0" on Pi 4

[imu]
# [restart]
driver         = "ism330dhcx"
i2c_addr       = 0x6B            # 0x6A via SA0 jumper
int_gpio       = 17              # BCM GPIO for FIFO watermark interrupt (pin 11)
odr_hz         = 833             # driver rounds to nearest: 12/26/52/104/208/416/833/1660
accel_g        = 8               # full-scale: 2 | 4 | 8 | 16
gyro_dps       = 2000            # full-scale: 125 | 250 | 500 | 1000 | 2000 | 4000
fifo_wm        = 32              # watermark in sample-sets (~38 ms at 833 Hz)

# Synthetic driver — no hardware needed.  Set int_gpio = 0 on both sensors so
# the reader threads use their 10 ms timer fallback instead of GPIO edges.
# Simulates a small boat: heading increases ~6°/s, roll ±4° (6 s period),
# pitch ±2° (8 s period), rate_of_turn ~360 deg/min with wave-induced oscillation.
#
# driver       = "sim"
# i2c_addr     = 0x00
# int_gpio     = 0
# odr_hz       = 833

[mag]
# [restart]
driver         = "mmc5983ma"
i2c_addr       = 0x30            # fixed, no alternate
int_gpio       = 27              # BCM GPIO for measurement-done interrupt (pin 13)
odr_hz         = 100             # driver rounds to nearest: 1/10/20/50/100/200/1000
set_period_s   = 5.0             # degauss pulse interval, seconds (0 = disable)

# driver       = "sim"
# i2c_addr     = 0x00
# int_gpio     = 0
# odr_hz       = 100
# set_period_s = 0.0

[fusion]
# Noise parameters from ISM330DHCX and MMC5983MA datasheets — not tuning knobs.
mekf_gyro_noise     = 0.007      # rad/s/√Hz  (ISM330DHCX: 7 mdps/√Hz)
mekf_gyro_bias      = 0.00015   # rad/s      (in-run bias instability)
mekf_accel_noise    = 0.0022    # m/s²/√Hz  (ISM330DHCX: ~186 µg/√Hz × 9.81)
mekf_mag_noise      = 0.0004    # Gauss/√Hz (MMC5983MA: 0.4 mGauss RMS)
mekf_wave_accel       = 0.8     # m/s^2  Gauss-Markov wave-acceleration sigma
mekf_wave_accel_tau_s = 0.5     # s      its correlation time (0 = state off)
mekf_mag_dip_sigma_deg = 1.0    # deg    dip-reference uncertainty (3-D mode only)

# Tuning knobs.
# Fine-grained measurement consistency is handled internally by chi-squared
# innovation gates (self-scaling with filter confidence); mag_reject_gauss is
# only the strong-anomaly cutoff for nearby iron/magnets.
mag_reject_gauss    = 0.05      # reject mag if residual > 0.05 Gauss (~10% of Earth field)
accel_skip_thresh   = 0.05      # skip accel update if ||a| - 1g| > 5% of g

# Magnetometer fusion mode. true (default) = heading-only: the mag corrects
# heading and never pulls on roll/pitch. Right choice for marine installs —
