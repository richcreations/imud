[Unit]
Description=IMU Daemon — 9DoF AHRS bridge (NMEA 0183 + binary UDP)
Documentation=man:imud(8) man:imud.conf(5)
After=network.target time-sync.target
Wants=time-sync.target
# time-sync.target ensures chrony has stepped the clock before the daemon
# starts emitting wall-clock timestamps in IMU packets.

[Service]
Type=notify
ExecStart=/usr/local/bin/imud --config /etc/imud/imud.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
# Health thread pets the watchdog every ~1 s; a hung daemon misses the
# 10 s window and systemd restarts it (counts as failure → Restart=).
WatchdogSec=10

# Dedicated system user; I2C and GPIO access via group membership.
# Create with: useradd -r -s /sbin/nologin -G i2c,gpio imud
User=imud
Group=gpio
SupplementaryGroups=i2c

# systemd creates /run/imud/ (mode 0750, owned by imud:gpio) before the
# service starts and removes it on stop.  The daemon writes its PID file
# and status socket here.
RuntimeDirectory=imud
RuntimeDirectoryMode=0750
PIDFile=/run/imud/imud.pid

# systemd creates /var/lib/imud/ (mode 0750, owned by imud:gpio) and keeps
# it across restarts.  The daemon reads/writes the calibration file here.
StateDirectory=imud
StateDirectoryMode=0750

# ── Security hardening ────────────────────────────────────────────────────

NoNewPrivileges=true
PrivateTmp=true

# /usr, /boot, /etc are read-only.  /var/log remains writable so the daemon
# can write to /var/log/imud.log (the default configured log path).
ProtectSystem=strict
ReadWritePaths=/var/lib/imud /var/log

ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true

# UDP output (AF_INET) and the status socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_UNIX

# Restrict hardware access to exactly the devices the daemon uses.
# Pi 4 defaults below.  For Pi 5, comment out gpiochip0 and uncomment gpiochip4.
DevicePolicy=closed
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/gpiochip0 rw
#DeviceAllow=/dev/gpiochip4 rw

# Memory ceiling (spec target: <14 MB RSS; 32 MB allows headroom).
MemoryMax=32M

# Protect against OOM kill on memory-constrained boards (Pi Zero 2W etc.).
OOMScoreAdjust=-500

# ── Logging ───────────────────────────────────────────────────────────────

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud

[Install]
WantedBy=multi-user.target
