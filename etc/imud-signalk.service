[Unit]
Description=imud → Signal K bridge (binary stream → Signal K delta over UDP)
# Starts after imud and prefers it running, but survives imud restarts on its
# own (it reconnects to the stream socket automatically).
After=imud.service
Wants=imud.service

[Service]
Type=notify
ExecStart=/usr/local/bin/imud-signalk --config /etc/imud/imud.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
# Main loop pets the watchdog every tick; a hung bridge is restarted.
WatchdogSec=10

# Runs as the imud user so it can read the 0660 imud:gpio stream socket in
# /run/imud/.  No hardware access is needed.
User=imud
Group=gpio

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
# UDP out (AF_INET) + the imud stream socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_UNIX
# No device access — the bridge touches no hardware.
DevicePolicy=closed

MemoryMax=16M
OOMScoreAdjust=-400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud-signalk

[Install]
WantedBy=multi-user.target
