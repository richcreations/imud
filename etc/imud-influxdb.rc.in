#!/bin/sh
#
# imud-influxdb.rc — the rc.d counterpart of etc/imud-influxdb.service.
#
#     sysrc imud_influxdb_enable=YES && service imud-influxdb start
#
# Requires imud's [stream] output: the bridge reads the AF_UNIX socket named in
# its own config, which is why REQUIRE lists imud.
#
# See etc/imud.rc.in for why the pidfile is the supervisor's rather than the
# bridge's, and for what -r -R 3 does and does not share with Restart=.
#
# NAME IS THE UNDERSCORE FORM, and the hyphenated one is kept in $svc.  rc.subr
# builds shell variable names out of $name — ${name}_program, ${name}_flags and
# more — so a hyphen there expands as $imud followed by the rest of the name as
# literal text, and run_rc_command fails with "cannot run -..._program" before
# the bridge is ever executed.

# PROVIDE: imud_influxdb
# REQUIRE: imud
# KEYWORD: shutdown

. /etc/rc.subr

name="imud_influxdb"
svc="imud-influxdb"
desc="imud → InfluxDB bridge (binary stream → line protocol over UDP/HTTP)"
rcvar="imud_influxdb_enable"

load_rc_config $name

: ${imud_influxdb_enable:="NO"}
: ${imud_influxdb_config:="@ETCDIR@/imud-influxdb.conf"}
: ${imud_influxdb_flags:=""}

pidfile="/var/run/imud/${svc}.supervisor.pid"

command="/usr/sbin/daemon"
command_args="-f -S -T ${svc} -P ${pidfile} -r -R 3 \
              @BINDIR@/imud-influxdb --config ${imud_influxdb_config} ${imud_influxdb_flags}"

start_precmd="imud_influxdb_precmd"

imud_influxdb_precmd()
{
	# Shared with imud, and made here too: a bridge may be started before the
	# daemon has ever run.
	install -d -m 0750 /var/run/imud
}

run_rc_command "$1"
