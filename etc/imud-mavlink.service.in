[Unit]
Description=imud → MAVLink bridge (binary stream → MAVLink over UDP/serial)
Documentation=man:imud-mavlink(8) man:imud-mavlink.conf(5)
# Starts after imud and prefers it running, but survives imud restarts on its
# own (it reconnects to the stream socket automatically).
After=imud.service network-online.target
Wants=imud.service network-online.target

[Service]
Type=notify
ExecStart=@BINDIR@/imud-mavlink --config /etc/imud/imud-mavlink.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
# Main loop pets the watchdog every tick; a hung bridge is restarted.
WatchdogSec=10

# Runs as the imud user and group so it can read the 0660 imud:imud stream
# socket in /run/imud/.  The dialout group + tty device access are for serial
# output; no gpio/i2c is needed.
User=imud
Group=imud
SupplementaryGroups=dialout

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectHostname=true
# The bridge never sets the clock, and — unlike imud — never reads the TAI
# offset either, so ProtectClock= costs it nothing.
ProtectClock=true
# The bridge reads nothing under /proc or /sys.
ProtectProc=invisible
ProcSubset=pid
# No capabilities: serial output is by dialout group membership (above), not
# by CAP_DAC_OVERRIDE.
CapabilityBoundingSet=
SystemCallArchitectures=native
# @system-service covers ioctl(), which is what the serial termios setup uses.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The bridge creates no files; 0077 costs nothing and covers anything a future
# addition might create.
UMask=0077
# UDP out (AF_INET/AF_INET6) + the imud stream socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No hardware except serial/tty devices (for serial output).
DevicePolicy=closed
DeviceAllow=char-tty rw

MemoryMax=16M
OOMScoreAdjust=-400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud-mavlink

[Install]
WantedBy=multi-user.target
