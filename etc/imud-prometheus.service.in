[Unit]
Description=imud → Prometheus exporter (binary stream → /metrics gauges)
Documentation=man:imud-prometheus(8) man:imud-prometheus.conf(5)
# Starts after imud and prefers it running, but survives imud restarts on its
# own (it reconnects to the stream socket automatically and answers scrapes
# with imud_up 0 meanwhile).
After=imud.service network-online.target
Wants=imud.service network-online.target

[Service]
Type=notify
ExecStart=@BINDIR@/imud-prometheus --config /etc/imud/imud-prometheus.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
# Main loop pets the watchdog every tick; a hung exporter is restarted.
WatchdogSec=10

# Runs as the imud user and group so it can read the 0660 imud:imud stream
# socket in /run/imud/.  No hardware access is needed, so no gpio/i2c here.
User=imud
Group=imud

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectHostname=true
# The exporter never sets the clock, and — unlike imud — never reads the TAI
# offset either, so ProtectClock= costs it nothing.
ProtectClock=true
# The exporter reads nothing under /proc or /sys.
ProtectProc=invisible
ProcSubset=pid
# No capabilities: it reads one socket and answers HTTP.
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The exporter creates no files; 0077 costs nothing and covers anything a
# future addition might create.
UMask=0077
# The HTTP listener (AF_INET/AF_INET6) + the imud stream socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No device access — the exporter touches no hardware.
DevicePolicy=closed

MemoryMax=16M
OOMScoreAdjust=-400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud-prometheus

[Install]
WantedBy=multi-user.target
