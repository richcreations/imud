[Unit]
Description=imud → Signal K bridge (binary stream → Signal K delta over UDP)
Documentation=man:imud-signalk(8) man:imud-signalk.conf(5)
# Starts after imud and prefers it running, but survives imud restarts on its
# own (it reconnects to the stream socket automatically).
After=imud.service
Wants=imud.service

[Service]
Type=notify
ExecStart=@BINDIR@/imud-signalk --config /etc/imud/imud-signalk.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
# Main loop pets the watchdog every tick; a hung bridge is restarted.
WatchdogSec=10

# Runs as the imud user and group so it can read the 0660 imud:imud stream
# socket in /run/imud/.  No hardware access is needed, so no gpio/i2c here.
User=imud
Group=imud

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectHostname=true
# The bridge never sets the clock, and — unlike imud — never reads the TAI
# offset either, so ProtectClock= costs it nothing.
ProtectClock=true
# The bridge reads nothing under /proc or /sys.
ProtectProc=invisible
ProcSubset=pid
# No capabilities: it reads one socket and writes to the network.
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The bridge creates no files; 0077 costs nothing and covers anything a future
# addition might create.
UMask=0077
# UDP out + the imud stream socket (AF_UNIX) only.  AF_INET6 is required
# because dest_addr resolves with getaddrinfo(AF_UNSPEC) since 1.7: a hostname
# that resolves to IPv6 fails at socket() without it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No device access — the bridge touches no hardware.
DevicePolicy=closed

MemoryMax=16M
OOMScoreAdjust=-400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud-signalk

[Install]
WantedBy=multi-user.target
