[Unit]
Description=imud → InfluxDB bridge (binary stream → line protocol over UDP/HTTP)
Documentation=man:imud-influxdb(8) man:imud-influxdb.conf(5)
# Starts after imud and prefers it running, but survives imud restarts on its
# own (it reconnects to the stream socket automatically).
After=imud.service network-online.target
Wants=imud.service network-online.target

[Service]
Type=notify
ExecStart=@BINDIR@/imud-influxdb --config /etc/imud/imud-influxdb.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
# Main loop pets the watchdog every tick; a hung bridge is restarted.
WatchdogSec=10

# Runs as the imud user and group so it can read the 0660 imud:imud stream
# socket in /run/imud/.  No hardware access is needed, so no gpio/i2c here.
# The imud group is also what makes the 0640 root:imud config readable.
User=imud
Group=imud

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectHostname=true
# The bridge never sets the clock, and — unlike imud — never reads the TAI
# offset either, so ProtectClock= costs it nothing.
ProtectClock=true
# The bridge reads nothing under /proc or /sys.
ProtectProc=invisible
ProcSubset=pid
# No capabilities: it reads one socket and writes to the network.
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The bridge creates no files; 0077 costs nothing and covers anything a future
# addition might create.
UMask=0077
# UDP/HTTP out (AF_INET/AF_INET6) + the imud stream socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No device access — the bridge touches no hardware.
DevicePolicy=closed

MemoryMax=16M
OOMScoreAdjust=-400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud-influxdb

[Install]
WantedBy=multi-user.target
