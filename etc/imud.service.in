[Unit]
Description=IMU Daemon — 9DoF AHRS bridge (NMEA 0183 + binary UDP)
Documentation=man:imud(8) man:imud.conf(5)
After=network.target time-sync.target
Wants=time-sync.target
# time-sync.target ensures chrony has stepped the clock before the daemon
# starts emitting wall-clock timestamps in IMU packets.

[Service]
Type=notify
ExecStart=@BINDIR@/imud --config /etc/imud/imud.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
# Health thread pets the watchdog every ~1 s; a hung daemon misses the
# 10 s window and systemd restarts it (counts as failure → Restart=).
WatchdogSec=10

# Dedicated system user and its own group; created by `make install` (or the
# package's maintainer scripts).  The imud group owns the runtime directory and
# both AF_UNIX sockets, so a consumer needs only `adduser <user> imud` — not
# membership of a hardware group.
User=imud
Group=imud
# Hardware access is by supplementary group: gpio for /dev/gpiochip*, i2c for
# /dev/i2c-*.  Both groups are created by the installer (they already exist on
# Raspberry Pi OS), and 60-imud.rules grants the group access to the device
# nodes on distributions shipping no equivalent of Pi OS's 99-com.rules.
SupplementaryGroups=gpio i2c

# systemd creates /run/imud/ (mode 0750, owned by imud:imud) before the
# service starts and removes it on stop.  The daemon writes its PID file
# and status socket here.
RuntimeDirectory=imud
RuntimeDirectoryMode=0750
PIDFile=/run/imud/imud.pid

# systemd creates /var/lib/imud/ (mode 0750, owned by imud:imud) and keeps
# it across restarts.  The daemon reads/writes the calibration file here.
StateDirectory=imud
StateDirectoryMode=0750

# ── Security hardening ────────────────────────────────────────────────────

NoNewPrivileges=true
PrivateTmp=true

# /usr, /boot, /etc are read-only.  /var/log remains writable so the daemon
# can write to /var/log/imud.log (the default configured log path).
ProtectSystem=strict
ReadWritePaths=/var/lib/imud /var/log

ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectHostname=true

# The daemon reads nothing under /proc or /sys.
ProtectProc=invisible
ProcSubset=pid

# UDP output (AF_INET) and the status socket (AF_UNIX) only.
RestrictAddressFamilies=AF_INET AF_UNIX

# No capabilities at all: hardware access is by supplementary group (above),
# and systemd — not the daemon — creates the runtime and state directories.
# This is also what makes the clock unsettable: adjtimex(2) and settimeofday(2)
# need CAP_SYS_TIME, which cannot be acquired from an empty bounding set under
# NoNewPrivileges=.
CapabilityBoundingSet=

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The first non-~ line above makes this an allow-list; later lines add to or
# subtract from it in order, so this re-allows what ~@privileged just removed.
#
# adjtimex(2) is in @clock and therefore in @privileged, but the daemon only
# ever calls it read-only (modes = 0) to report the CLOCK_TAI offset at
# startup.  Blocking it makes that check log a false "chrony has not set
# tai_offset" on every boot.  Setting the clock stays impossible via the empty
# CapabilityBoundingSet= above, so ProtectClock= — which would block adjtimex
# outright, with no way to allow it back — is deliberately NOT set here.  The
# five bridge units do set it; none of them calls adjtimex.
SystemCallFilter=adjtimex

# 0027, not 0077: the daemon's own files carry explicit modes (fileio.h), but
# /var/log/imud.log is opened 0640 so imud-group members can tail it, and 0077
# would mask that down to 0600.  main() tightens this further if it inherits
# something stricter, and never loosens it.
UMask=0027

# Restrict hardware access to exactly the devices the daemon can use.
#
# Every supported node is listed rather than one board's, and there is no
# "comment out the other one" step: a DeviceAllow= for a node that does not
# exist on this board is inert, so one unit is correct on both a Pi 4 and a
# Pi 5.  The alternative shipped a config template naming gpiochip4 (right for
# a Pi 5) alongside a unit allowing only gpiochip0, which under
# DevicePolicy=closed meant the daemon was blocked from the very chip its own
# default config asked for — a pairing no operator could get right without
# editing two files.
#
# Keep this list in step with the [device] section of config/imud.conf;
# tools/check-devices.py (make check-devices) fails the build if it drifts.
# NO trailing comments on the DeviceAllow= lines below.  systemd parses the
# rest of the line as the device rights, so "rw  # Pi 4" is invalid rights and
# the whole line is IGNORED — which under DevicePolicy=closed silently allows
# nothing at all.  It logs at info level and `systemd-analyze verify` is the
# only thing that says so.
DevicePolicy=closed
# /dev/i2c-1: Pi 4 and Pi 5 default header pins.  /dev/i2c-3: Pi 5 alternate.
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/i2c-3 rw
# gpiochip0: Pi 4.  gpiochip4: Pi 5 (RP1).
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip4 rw

# Memory ceiling (spec target: <14 MB RSS; 32 MB allows headroom).
MemoryMax=32M

# Protect against OOM kill on memory-constrained boards (Pi Zero 2W etc.).
OOMScoreAdjust=-500

# ── Logging ───────────────────────────────────────────────────────────────

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imud

[Install]
WantedBy=multi-user.target
