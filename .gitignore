# Build artifacts.
# Binary names are anchored with a leading "/" so they match only the repo-root
# executables, NOT same-named directories like docs/imud-signalk/ or
# packaging/imud/.
src/*.o
src/drivers/*.o
src/*.d
src/drivers/*.d
/imud
/imud-cal
/imud-imutest
/imud-status
/imud-mon
/imud-signalk
/imud-mqtt
/imud-influxdb
/imud-mavlink
/imud-prometheus

# Test binaries
/test_fusion
/test_fit_ra
/test_config
/test_nmea
/test_packet
/test_capture
/fuzz_config
/fuzz_json
/fuzz_packet
/fuzz_capture
/fuzz_wmm
/fuzz_cal
/test_ring
/test_concurrency
/test_mount
/test_cal
/test_cal_math
/test_wmm
/test_position
/test_client
/test_stream
/test_netserv
/test_log
/test_signalk
/test_mqtt
/test_influxdb
/test_mavlink
/test_libimud
/test_bridge
/test_prometheus
/test_drivers_registry
/test_imu_math
/test_drivers
/test_imutest

# Coverage artifacts (make coverage)
*.gcno
*.gcda
/coverage.info
/coverage-html/

# libimud build products
/libimud.so
/libimud.so.*
/libimud.pc
lib/*.o
lib/*.d

# Python bytecode
__pycache__/
*.pyc

# Generated systemd units (from etc/*.service.in; see Makefile)
/etc/*.service

# Release tarballs (make dist)
/imud-*.tar.gz

# Editor and OS
.DS_Store
*.swp
*.swo
*~
.vscode/settings.json
.claude

# Local agent guidance (not shipped)
AGENTS.md
audit.md
# Cal file (machine-specific, not for version control)
cal.json

# macOS debug-symbol bundles from -g builds (never commit build artifacts)
*.dSYM/
*.imucap
# ...but fuzz corpus seeds are tracked test data, not build products
!test/fuzz/corpus/**/*.imucap

# Manufacturer datasheets are reference-only and never committed: they are
# copyrighted with no redistribution licence, and shipping them would make the
# source tarball non-DFSG-free.  See docs/datasheets.md — drivers cite a
# datasheet revision in their header comment instead.
docs/*.pdf
# ...but docs/math.pdf is generated in-tree from docs/math.md and IS tracked.
!docs/math.pdf

# debian build artifacts (dpkg-buildpackage)
/debian/tmp/
/debian/.debhelper/
/debian/files
/debian/*.substvars
/debian/*.debhelper
/debian/debhelper-build-stamp
/debian/imud/
/debian/imud-utils/
/debian/libimud0/
/debian/libimud-dev/
/debian/imud-signalk/
/debian/imud-mqtt/
/debian/imud-influxdb/
/debian/imud-mavlink/
/debian/imud-prometheus/
/debian/imud-wmm-data/

# Temporary per-unit calibration data captured during bench work (not source).
/temp-fit.json

# apt-repo: the served site tree is generated by the workflow, never committed
/site/
# No .deb belongs on this branch at all — the apt pool lives on the orphan
# `apt-pool` branch (see apt/README.md).  Binaries committed here are
# permanent, which is what took the repo to 75 MB before 1.8.
/*.deb
