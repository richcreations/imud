#!/bin/sh
# postinst for imud-mqtt — the config can hold a plaintext broker password, so
# it ships 0640 and is given to the imud group here.  dpkg unpacks everything
# root:root, so ownership cannot come from the .deb itself.  The imud group is
# created by the imud package's postinst, which dpkg configures first (imud-mqtt
# Depends: imud).  Run on every configure, so an upgrade from a release that
# installed the file 0644 repairs it.
set -e

case "$1" in
    configure)
        conf=/etc/imud/imud-mqtt.conf
        if [ -e "$conf" ] && getent group imud >/dev/null; then
            chgrp imud "$conf" && chmod 640 "$conf"
        fi
        # A config the bridge will refuse is said now, not by a failed restart.
        if ! imud-mqtt --check-config --config "$conf" >/dev/null; then
            echo "imud-mqtt: imud-mqtt will not start until the errors" \
                 "above are corrected; then: systemctl restart imud-mqtt" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
