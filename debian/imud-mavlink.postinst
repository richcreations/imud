#!/bin/sh
# postinst for imud-mavlink — the serial output mode needs the imud user
# (created by the imud package this depends on at runtime) in dialout.
set -e

case "$1" in
    configure)
        if getent passwd imud >/dev/null && getent group dialout >/dev/null; then
            adduser --quiet imud dialout || true
        fi
        # A config the bridge will refuse is said now, not by a failed restart.
        if ! imud-mavlink --check-config --config /etc/imud/imud-mavlink.conf >/dev/null; then
            echo "imud-mavlink: imud-mavlink will not start until the errors" \
                 "above are corrected; then: systemctl restart imud-mavlink" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
