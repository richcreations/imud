#!/usr/bin/make -f
# imud — multi-binary Debian build on top of the upstream Makefile's
# install targets (pure file copies when DESTDIR is set; user creation and
# systemd handling live in maintainer scripts / debhelper).
#
# dh_auto_* is used (not bare $(MAKE)) so dpkg-buildflags hardening flags
# reach every compile and link — the Makefile respects external CFLAGS /
# CPPFLAGS / LDFLAGS by design.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Multiarch library path: the .so and libimud.pc must live under the triplet
# dir, or pkg-config's cross-compilation wrapper cannot find the .pc.
# libimud.pc is generated from @LIBDIR@, so it follows automatically.
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

# ./configure is ours, not autotools: it takes --prefix and the seam switches
# and rejects everything else.  debhelper finds any executable named configure
# and calls it with the full autotools argument set (--build=, --disable-*,
# --runstatedir=), which it refuses — so the deb build died at the first option.
# Skipped rather than taught those options: the Makefile probes for itself when
# there is no config.mk, and dh_auto_build below already passes what we want.
override_dh_auto_configure:

override_dh_auto_build:
	dh_auto_build -- PREFIX=/usr
	dh_auto_build -- bridges PREFIX=/usr

override_dh_auto_install:
	dh_auto_install -- install-utils install-wmm-data \
	        install-signalk install-mqtt install-influxdb \
	        install-mavlink install-prometheus \
	        install-info-doc \
	        PREFIX=/usr SVCDIR=/usr/lib/systemd/system \
	        UDEVDIR=/usr/lib/udev/rules.d \
	        LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)
	# This is a non-native package (3.0 (quilt), version X.Y-N), so the
	# per-package Debian changelog belongs at changelog.Debian.gz — Policy
	# 12.7; changelog.gz is the NATIVE name.  The upstream install target
	# stages it under the native name (correct for a source install), so
	# rename it here rather than teach the Makefile about Debian revisions.
	for d in debian/tmp/usr/share/doc/*/; do \
	    if [ -f "$$d/changelog.gz" ]; then \
	        mv "$$d/changelog.gz" "$$d/changelog.Debian.gz"; \
	    fi; \
	done

# imud-mqtt.conf can hold a plaintext broker password and imud-influxdb.conf an
# InfluxDB API token, so both install 0640 (group set to imud by each package's
# postinst — dpkg unpacks everything root:root).  dh_fixperms would reset them
# to 0644 and put the credentials back in every local user's reach.
override_dh_fixperms:
	dh_fixperms -Xetc/imud/imud-mqtt.conf -Xetc/imud/imud-influxdb.conf

# The upstream install targets already lay out /usr/share/doc/<pkg>/
# (DEP-5 copyright + the per-package changelog, renamed above) per package;
# keep those and skip debhelper's defaults.
#
# Exception: the library's docs are staged under its own name
# (usr/share/doc/libimud), not the binary package names — libimud0.install
# remaps them, and libimud-dev.links symlinks to libimud0's (permitted: it
# already Depends on libimud0 (= ${binary:Version})).  Since dh_installdocs
# is skipped, nothing else would create those directories.
override_dh_installchangelogs:
override_dh_installdocs:
