#!/bin/sh
# postinst for imud — create the system user the service runs as and grant
# the hardware groups.  User removal is deliberately NOT done in postrm
# (Debian convention: system users stay so file ownership never dangles).
set -e

case "$1" in
    configure)
        if ! getent passwd imud >/dev/null; then
            adduser --system --group --no-create-home \
                    --home /var/lib/imud --quiet imud
        fi
        # Raspberry Pi OS ships gpio, i2c and spi; stock Debian ships none of
        # them, and the unit's SupplementaryGroups= refuses to start without
        # them.  Creating them is harmless where they already exist.
        for grp in gpio i2c spi; do
            if ! getent group "$grp" >/dev/null; then
                addgroup --system "$grp" || true
            fi
            adduser --quiet imud "$grp" || true
        done
        # Device nodes need the group bits too — 60-imud.rules provides them on
        # distributions with no equivalent of Pi OS's 99-com.rules.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=i2c-dev \
                            --subsystem-match=spidev \
                            --subsystem-match=gpio || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
